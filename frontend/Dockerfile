FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM node:22-alpine AS build
WORKDIR /app
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_CAMPAIGN_NAME="Team Shahbal"
ARG NEXT_PUBLIC_CAMPAIGN_TAGLINE="Mombasa 2027 · Campaign Command"
ARG NEXT_PUBLIC_CANDIDATE_NAME="Suleiman Shahbal"
ARG NEXT_PUBLIC_GIS_URL=/gis/
ARG NEXT_PUBLIC_SIP_WSS_ORIGIN=
ARG NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
ARG NEXT_PUBLIC_MAPILLARY_TOKEN=
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_CAMPAIGN_NAME=$NEXT_PUBLIC_CAMPAIGN_NAME \
    NEXT_PUBLIC_CAMPAIGN_TAGLINE=$NEXT_PUBLIC_CAMPAIGN_TAGLINE \
    NEXT_PUBLIC_CANDIDATE_NAME=$NEXT_PUBLIC_CANDIDATE_NAME \
    NEXT_PUBLIC_GIS_URL=$NEXT_PUBLIC_GIS_URL \
    NEXT_PUBLIC_SIP_WSS_ORIGIN=$NEXT_PUBLIC_SIP_WSS_ORIGIN \
    NEXT_PUBLIC_MAP_STYLE=$NEXT_PUBLIC_MAP_STYLE \
    NEXT_PUBLIC_MAPILLARY_TOKEN=$NEXT_PUBLIC_MAPILLARY_TOKEN \
    NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
EXPOSE 3000
CMD ["node", "server.js"]
