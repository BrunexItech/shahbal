# Generate real secrets before any deployment:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"          -> JWT_SECRET, PII_PEPPER
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"  -> PII_KEY
# PII_KEY and PII_PEPPER can never change once real data exists (IDs become unreadable / undeduplicable).
APP_NAME=Campaign HQ
DATABASE_URL=postgresql+asyncpg://shahbal:shahbal@localhost:5436/shahbal
JWT_SECRET=change-me
PII_KEY=
PII_PEPPER=change-me
CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development
WEBHOOK_SECRET=change-me-webhook
# Real client IP: number of proxies in front of the API, or a header your edge sets.
TRUSTED_PROXIES=0
# CLIENT_IP_HEADER=cf-connecting-ip
# Messaging (sandbox logs instead of sending)
SMS_PROVIDER=sandbox   # sandbox | mobilesasa | africastalking
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
WHATSAPP_PROVIDER=sandbox
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_TEMPLATE=campaign_update
# Passkeys: the bare domain and the exact https origin(s) the app is served on.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=["http://localhost:3000","http://localhost:8090"]
# Call centre: sandbox (training) or sip (real calls via a SIP-over-WebSocket carrier)
VOICE_PROVIDER=sandbox
SIP_WSS_URL=
SIP_DOMAIN=
SIP_CALLER_ID=
RECORDINGS_DIR=./data/recordings
RECORDING_RETENTION_DAYS=90
GIS_ORIGIN=http://localhost:8081
APP_URL=http://localhost:3000

# ── Bulk SMS: Mobile Sasa ──────────────────────────────────────────────────────
MOBILESASA_TOKEN=               # mbs_…
MOBILESASA_SENDER_ID=           # approved sender ID (case-sensitive)
MOBILESASA_WEBHOOK_SECRET=      # portal → Settings → Webhooks
MOBILESASA_SIGNING_SECRET=      # portal → Settings → Webhooks

# ── Call centre: Cloud One SIP trunk + PBX (see pbx/README.md) ─────────────────
CLOUDONE_SIP_HOST=
CLOUDONE_SIP_USER=
CLOUDONE_SIP_PASSWORD=
CLOUDONE_DID=                   # local format, e.g. 0207900000 (caller ID)
PBX_PUBLIC_IP=                  # server public IP
PBX_SYNC_SECRET=                # openssl rand -hex 24
TURN_USERNAME=shahbal
TURN_PASSWORD=                  # openssl rand -hex 16
# PBX_SIP_PORT=5070  PBX_WS_PORT=8189  PBX_RTP_START=20000  PBX_RTP_END=24999
# TURN_PORT=3479  TURN_MIN_PORT=49300  TURN_MAX_PORT=49399
# PBX_BACKEND_URL=http://127.0.0.1:8091/api/v1   # the gateway port on this server
TURN_URL=                       # turn:SERVER-PUBLIC-IP:3479
