# Generate real secrets before any deployment:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"          -> JWT_SECRET, PII_PEPPER
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"  -> PII_KEY
# PII_KEY and PII_PEPPER can never change once real data exists (IDs become unreadable / undeduplicable).
