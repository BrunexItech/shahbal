# Generate real secrets before any deployment:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"          -> JWT_SECRET, PII_PEPPER
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"  -> PII_KEY
# PII_KEY and PII_PEPPER can never change once real data exists (IDs become unreadable / undeduplicable).
APP_NAME=Campaign HQ
DATABASE_URL=postgresql+asyncpg://shahbal:shahbal@localhost:5436/shahbal
JWT_SECRET=change-me
PII_KEY=
PII_PEPPER=change-me
CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development
WEBHOOK_SECRET=change-me-webhook
# Real client IP: number of proxies in front of the API, or a header your edge sets.
TRUSTED_PROXIES=0
# CLIENT_IP_HEADER=cf-connecting-ip
# Messaging (sandbox logs instead of sending)
SMS_PROVIDER=sandbox
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
WHATSAPP_PROVIDER=sandbox
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_TEMPLATE=campaign_update
# Passkeys: the bare domain and the exact https origin(s) the app is served on.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=["http://localhost:3000","http://localhost:8090"]
# Call centre: sandbox (training) or sip (real calls via a SIP-over-WebSocket carrier)
VOICE_PROVIDER=sandbox
SIP_WSS_URL=
SIP_DOMAIN=
SIP_CALLER_ID=
RECORDINGS_DIR=./data/recordings
RECORDING_RETENTION_DAYS=90
GIS_ORIGIN=http://localhost:8081
APP_URL=http://localhost:3000
